schema: dotnet-axi/v1
command: help
status: success
topic: home
usage: "dnaxi [options] [command]"
description: "Deterministic .NET discovery, analysis, validation, and safe modification."
classification: passive
arguments: []
flags[2]:
  - name: "--help"
    aliases[4]: "-?","-h",/?,/h
    required: false
    minimum_values: 0
    maximum_values: 0
    inherited: false
    description: Show structured help for the selected command.
  - name: "--version"
    aliases[1]: "-v"
    required: false
    minimum_values: 0
    maximum_values: 0
    inherited: false
    description: Show installed versions and passive compatibility capabilities.
subcommands[3]{name,description,classification}:
  outline,Show the stable Roslyn syntax structure of one C# document or symbol.,passive
  search,Search the current workspace.,passive
  show,Show bounded detail for one stable evidence identity or document.,passive
examples[3]{command}:
  dnx dnaxi@<tool-version> --verbosity quiet --
  dnx dnaxi@<tool-version> --verbosity quiet -- --help
  dnx dnaxi@<tool-version> --verbosity quiet -- --version
