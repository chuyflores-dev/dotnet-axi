schema: dotnet-axi/v1
command: help
status: success
topic: inspect
usage: "dnaxi inspect <target> [options]"
description: Inspect one registered target.
classification: executing
guidance:
  invocation: dnx dnaxi@<tool-version> --verbosity quiet -- <command>
  authority: "Treat the invoked version's structured help, version, and reported capabilities as authoritative. Never use a command or option that it does not expose."
  next_steps[3]: "For .NET file, literal, regular-expression, or stable-syntax discovery, run the matching bounded `search` route through `dnx dnaxi@<tool-version> --verbosity quiet --` when the invoked version reports it.",Invoke known source-discovery routes directly; do not add a help probe before a known route. Inspect only the narrowest relevant help once when no documented route or option applies.,"Read an already-known file directly when that is smaller. If the required capability is unavailable, use an available direct tool and report the gap."
arguments[1]{name,required,value_type,minimum_values,maximum_values,description}:
  target,true,string,1,1,Stable ID or exact target name.
flags[4]:
  - name: "--format"
    aliases[1]: "-f"
    required: false
    value_type: string
    minimum_values: 1
    maximum_values: 1
    default_value: summary
    inherited: false
    description: Select the detail format.
  - name: "--help"
    aliases[4]: "-?","-h",/?,/h
    required: false
    minimum_values: 0
    maximum_values: 0
    inherited: true
    description: Show structured help for the selected command.
  - name: "--project"
    aliases: []
    required: true
    value_type: string
    minimum_values: 1
    maximum_values: 1
    inherited: false
    description: Limit inspection to one project.
  - name: "--solution"
    aliases: []
    required: false
    value_type: string
    minimum_values: 1
    maximum_values: 1
    inherited: true
    description: Select a solution path.
subcommands: []
examples[2]{command}:
  dnx dnaxi@<tool-version> --verbosity quiet -- inspect sym_123 --project src/App/App.csproj
  dnx dnaxi@<tool-version> --verbosity quiet -- inspect sym_123 --project src/App/App.csproj --format detailed
