<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dnaxi</AssemblyName>
    <RootNamespace>DotNetAxi.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dnaxi</ToolCommandName>
    <PackageId>dnaxi</PackageId>
    <Title>dotnet-axi</Title>
    <Authors>chuyflores-dev</Authors>
    <Description>Agent-first deterministic discovery, analysis, validation, and safe modification for .NET codebases.</Description>
    <PackageTags>dotnet;cli;developer-tools;code-analysis;agents</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/chuyflores-dev/dotnet-axi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chuyflores-dev/dotnet-axi.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackagedAgentSkillPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/pack/skills/dotnet-axi/SKILL.md</PackagedAgentSkillPath>
  </PropertyGroup>

  <ItemGroup>
    <None
      Include="../../README.md"
      Pack="true"
      PackagePath="/"
      Link="README.md" />
    <None
      Include="$(PackagedAgentSkillPath)"
      Pack="true"
      PackagePath="skills/dotnet-axi/" />
    <None
      Include="../../skills/dotnet-axi/references/codex.md"
      Pack="true"
      PackagePath="skills/dotnet-axi/references/" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <Target Name="PrepareVersionedPackagedAgentSkill" BeforeTargets="GenerateNuspec">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PackagedAgentSkillPath)'))" />
    <PropertyGroup>
      <PackagedAgentSkillContent>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../skills/dotnet-axi/SKILL.md'))').Replace('&lt;exact-version&gt;', '$(PackageVersion)'))))</PackagedAgentSkillContent>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(PackagedAgentSkillPath)"
      Lines="$(PackagedAgentSkillContent)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <AssemblyMetadata
      Include="DotNetAxi.ToolVersion"
      Value="$(PackageVersion)" />
    <InternalsVisibleTo Include="DotNetAxi.Cli.TestApp" />
    <InternalsVisibleTo Include="DotNetAxi.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DotNetAxi.Analysis/DotNetAxi.Analysis.csproj" />
    <ProjectReference Include="../DotNetAxi.Axi/DotNetAxi.Axi.csproj" />
    <ProjectReference Include="../DotNetAxi.Changes/DotNetAxi.Changes.csproj" />
    <ProjectReference Include="../DotNetAxi.Contracts/DotNetAxi.Contracts.csproj" />
    <ProjectReference Include="../DotNetAxi.DotNet/DotNetAxi.DotNet.csproj" />
    <ProjectReference Include="../DotNetAxi.Graph/DotNetAxi.Graph.csproj" />
    <ProjectReference Include="../DotNetAxi.Roslyn/DotNetAxi.Roslyn.csproj" />
    <ProjectReference Include="../DotNetAxi.Search/DotNetAxi.Search.csproj" />
    <ProjectReference Include="../DotNetAxi.Structural/DotNetAxi.Structural.csproj" />
    <ProjectReference Include="../DotNetAxi.Validation/DotNetAxi.Validation.csproj" />
    <ProjectReference Include="../DotNetAxi.Workspaces/DotNetAxi.Workspaces.csproj" />
  </ItemGroup>
</Project>
